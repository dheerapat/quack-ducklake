#!/bin/sh
set -eu

: "${DUCKDB_CATALOG_PATH:?DUCKDB_CATALOG_PATH is required}"
: "${DUCKLAKE_DATA_PATH:?DUCKLAKE_DATA_PATH is required}"
: "${DUCKDB_SECRETS:?DUCKDB_SECRETS is required}"
: "${QUACK_TOKEN:?QUACK_TOKEN is required}"

case "$QUACK_TOKEN" in
  *"'"*|*"\""*|*\\*) echo 'QUACK_TOKEN contains an unsupported quote or slash' >&2; exit 1 ;;
esac
if printf '%s' "$QUACK_TOKEN$DUCKDB_SECRETS" | LC_ALL=C grep -q '[^ -~]'; then
  echo 'Quack token and DUCKDB_SECRETS must contain printable ASCII characters' >&2
  exit 1
fi

if [ "${#QUACK_TOKEN}" -lt 4 ]; then
  echo 'QUACK_TOKEN must contain at least four characters' >&2
  exit 1
fi

sql_file=$(mktemp)
secret_bodies=$(mktemp)
input_pipe=$(mktemp -u)
mkfifo "$input_pipe"
cat >"$sql_file" <<SQL
INSTALL httpfs;
INSTALL ducklake;
INSTALL postgres;
INSTALL quack;
LOAD httpfs;
LOAD ducklake;
LOAD postgres;
LOAD quack;
SQL

printf '%s' "$DUCKDB_SECRETS" | tr ';' '\n' >"$secret_bodies"
secret_count=0
while IFS= read -r secret_body || [ -n "$secret_body" ]; do
  compact=$(printf '%s' "$secret_body" | tr -d '[:space:]')
  [ -n "$compact" ] || continue
  secret_count=$((secret_count + 1))
  printf 'CREATE OR REPLACE SECRET ducan_storage_%s (%s);\n' "$secret_count" "$secret_body" >>"$sql_file"
done <"$secret_bodies"
[ "$secret_count" -gt 0 ] || { echo 'DUCKDB_SECRETS contains no secret definitions' >&2; exit 1; }

keepalive_pid=''
cleanup() {
  [ -z "$keepalive_pid" ] || kill "$keepalive_pid" 2>/dev/null || true
  rm -f "$sql_file" "$secret_bodies" "$input_pipe"
}
trap cleanup EXIT INT TERM

cat >>"$sql_file" <<SQL

ATTACH 'ducklake:${DUCKDB_CATALOG_PATH}' AS lake (
  DATA_PATH '${DUCKLAKE_DATA_PATH}',
  DATA_INLINING_ROW_LIMIT 0
);
USE lake;
CREATE SCHEMA IF NOT EXISTS lake.raw;

CALL quack_serve(
  'quack:0.0.0.0:9494',
  token => '${QUACK_TOKEN}',
  allow_other_hostname => true,
  disable_ssl => true
);

SELECT 'DuckDB Quack server ready' AS status;
SQL

# Keep the DuckDB session alive after bootstrap. The attached catalog and Quack
# listener belong to this one process; no other process opens db.duckdb.
tail -f /dev/null >"$input_pipe" &
keepalive_pid=$!
duckdb :memory: -init "$sql_file" <"$input_pipe"
