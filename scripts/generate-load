#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

rows=1000000
batch_size=100000
checkpoint_every=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --rows) rows=${2:?--rows requires a value}; shift 2 ;;
    --batch-size) batch_size=${2:?--batch-size requires a value}; shift 2 ;;
    --checkpoint-every) checkpoint_every=${2:?--checkpoint-every requires a value}; shift 2 ;;
    -h|--help)
      printf '%s\n' 'usage: scripts/generate-load [--rows N] [--batch-size N] [--checkpoint-every N]'
      exit 0
      ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done

is_uint() {
  case "$1" in
    ''|*[!0-9]*) return 1 ;;
  esac
}
is_uint "$rows" && is_uint "$batch_size" && is_uint "$checkpoint_every" || {
  echo 'rows, batch-size, and checkpoint-every must be non-negative integers' >&2
  exit 2
}
[ "$rows" -gt 0 ] || { echo '--rows must be positive' >&2; exit 2; }
[ "$batch_size" -gt 0 ] || { echo '--batch-size must be positive' >&2; exit 2; }

DUCKDB_BIN=${DUCKDB_BIN:-duckdb}
command -v "$DUCKDB_BIN" >/dev/null 2>&1 || {
  echo "DuckDB CLI not found: $DUCKDB_BIN (install DuckDB 1.5.3 or newer)" >&2
  exit 2
}
TOKEN=${QUACK_TOKEN:-local-quack-token}
case "$TOKEN" in
  *"'"*|*"\""*|*\\*) echo 'QUACK_TOKEN contains an unsupported quote or slash' >&2; exit 2 ;;
esac
if printf '%s' "$TOKEN" | LC_ALL=C grep -q '[^ -~]'; then
  echo 'QUACK_TOKEN must contain printable ASCII characters' >&2
  exit 2
fi
QUACK_PORT=${QUACK_PORT:-9494}
is_uint "$QUACK_PORT" && [ "$QUACK_PORT" -gt 0 ] && [ "$QUACK_PORT" -le 65535 ] || {
  echo 'QUACK_PORT must be a valid port number' >&2
  exit 2
}
query() {
  "$DUCKDB_BIN" -csv :memory: -c "$1"
}
wait_for_server() {
  SQL="INSTALL quack; LOAD quack; SELECT * FROM quack_query('quack:127.0.0.1:${QUACK_PORT}', 'SELECT 42 AS ready', token => '${TOKEN}', disable_ssl => true);"
  for attempt in $(seq 1 30); do
    if output=$(query "$SQL" 2>/dev/null); then
      printf '%s\n' "$output"
      return 0
    fi
    [ "$attempt" -eq 30 ] && break
    sleep 2
  done
  echo 'DuckDB server did not become ready through local DuckDB' >&2
  return 1
}

docker compose up -d rustfs bucket-init duckdb-server
wait_for_server

sql_file=$(mktemp)
cleanup() { rm -f "$sql_file"; }
trap cleanup EXIT INT TERM
{
  printf '%s\n' 'INSTALL quack; LOAD quack;'
  start=0
  batch=0
  while [ "$start" -lt "$rows" ]; do
    end=$((start + batch_size))
    [ "$end" -le "$rows" ] || end=$rows
    count=$((end - start))
    remote_sql="BEGIN; INSERT INTO lake.events SELECT i, TIMESTAMP ''2026-01-01 00:00:00'' + i * INTERVAL 1 SECOND, ''customer-'' || (i % 10000), random() * 100 FROM range(${start}, ${end}) AS r(i); COMMIT; SELECT ${count} AS inserted_rows"
    printf "SELECT * FROM quack_query('quack:127.0.0.1:%s', '%s', token => '%s', disable_ssl => true);\n" "$QUACK_PORT" "$remote_sql" "$TOKEN"
    batch=$((batch + 1))
    start=$end
    if [ "$checkpoint_every" -gt 0 ] && [ $((batch % checkpoint_every)) -eq 0 ]; then
      remote_sql="CHECKPOINT; SELECT ${start} AS checkpointed_rows"
      printf "SELECT * FROM quack_query('quack:127.0.0.1:%s', '%s', token => '%s', disable_ssl => true);\n" "$QUACK_PORT" "$remote_sql" "$TOKEN"
    fi
  done
  printf "SELECT * FROM quack_query('quack:127.0.0.1:%s', 'SELECT count() AS total_rows FROM lake.events', token => '%s', disable_ssl => true);\n" "$QUACK_PORT" "$TOKEN"
} >"$sql_file"

"$DUCKDB_BIN" -csv :memory: <"$sql_file"
