#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

compose() { docker compose "$@"; }
DUCKDB_BIN=${DUCKDB_BIN:-duckdb}
command -v "$DUCKDB_BIN" >/dev/null 2>&1 || {
  echo "DuckDB CLI not found: $DUCKDB_BIN (install DuckDB 2.0.0 or newer)" >&2
  exit 2
}
query() {
  "$DUCKDB_BIN" -csv :memory: -c "$1"
}
TOKEN=${QUACK_TOKEN:-local-quack-token}
QUACK_PORT=${QUACK_PORT:-9494}
case "$TOKEN" in
  *"'"*|*"\""*|*\\*) echo 'QUACK_TOKEN contains an unsupported quote or slash' >&2; exit 2 ;;
esac
if printf '%s' "$TOKEN" | LC_ALL=C grep -q '[^ -~]'; then
  echo 'QUACK_TOKEN must contain printable ASCII characters' >&2
  exit 2
fi
wait_for_server() {
  SQL="INSTALL quack; LOAD quack; ATTACH 'quack:127.0.0.1:${QUACK_PORT}' AS qk (TOKEN '${TOKEN}'); CONNECT qk; SELECT 42 AS ready;"
  for attempt in $(seq 1 30); do
    if output=$(query "$SQL" 2>/dev/null); then
      printf '%s\n' "$output"
      return 0
    fi
    [ "$attempt" -eq 30 ] && break
    sleep 2
  done
  echo 'DuckDB server did not become ready' >&2
  return 1
}

compose up -d rustfs
compose up -d bucket-init
compose up -d duckdb-server

wait_for_server

query "INSTALL quack; LOAD quack; ATTACH 'quack:127.0.0.1:${QUACK_PORT}' AS qk (TOKEN '${TOKEN}'); CONNECT qk; CREATE TABLE IF NOT EXISTS lake.events (id BIGINT, event_ts TIMESTAMP, customer VARCHAR, amount DOUBLE); INSERT INTO lake.events SELECT * FROM (VALUES (1, TIMESTAMP '2026-01-01 00:00:00', 'smoke', 42.0), (2, TIMESTAMP '2026-01-01 00:00:01', 'smoke', 7.5)) AS t(id, event_ts, customer, amount); SELECT count() AS rows FROM lake.events;"

objects=$(compose run --rm --no-deps --entrypoint /bin/sh bucket-init -c 'aws --endpoint-url http://rustfs:9000 s3 ls "s3://$LAKEHOUSE_BUCKET" --recursive' 2>/dev/null || true)
printf '%s\n' "$objects"
echo "$objects" | grep -q '\.parquet' || { echo 'Smoke test found no Parquet object in RustFS' >&2; exit 1; }

compose restart duckdb-server >/dev/null
sleep 3
wait_for_server
query "INSTALL quack; LOAD quack; ATTACH 'quack:127.0.0.1:${QUACK_PORT}' AS qk (TOKEN '${TOKEN}'); CONNECT qk; SELECT count() AS rows FROM lake.events;"
echo 'smoke test passed'
