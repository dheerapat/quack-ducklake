# DuckDB/RustFS local simulation defaults. Copy to .env before starting.
DUCKDB_IMAGE=duckdb/duckdb:1.5.3
RUSTFS_IMAGE=rustfs/rustfs:latest
AWS_CLI_IMAGE=amazon/aws-cli:2.36.8

RUSTFS_ACCESS_KEY=ducklake_access
RUSTFS_SECRET_KEY=change-me-before-sharing
RUSTFS_REGION=us-east-1
RUSTFS_ENDPOINT=rustfs:9000
# Bucket used by DuckLake. RustFS is the local S3-compatible test backend.
S3_BUCKET=lakehouse
LAKEHOUSE_BUCKET=lakehouse
# Semicolon-separated DuckDB CREATE SECRET bodies.
DUCKDB_SECRETS=TYPE s3, KEY_ID 'ducklake_access', SECRET 'ducklake_secret', REGION 'us-east-1', ENDPOINT 'rustfs:9000', USE_SSL false, URL_STYLE 'path'

QUACK_TOKEN=change-me-quack-token
RUSTFS_BIND_ADDRESS=127.0.0.1
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
QUACK_BIND_ADDRESS=127.0.0.1
QUACK_PORT=9494

DUCAN_API_TOKEN=change-me-ducan-token
DUCAN_BIND_ADDRESS=127.0.0.1
DUCAN_API_PORT=8080
