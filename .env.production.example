# Ducan production settings. Use an external S3-compatible object store.
DUCKDB_IMAGE=duckdb/duckdb:1.5.3

# s3.amazonaws.com, s3.eu-west-1.amazonaws.com, R2, MinIO, etc.
S3_BUCKET=forecaster-dataset-development
# Semicolon-separated DuckDB CREATE SECRET bodies. Add more secrets as needed.
DUCKDB_SECRETS=TYPE s3, KEY_ID 'replace-me', SECRET 'replace-me', REGION 'us-east-1', ENDPOINT 's3.example.com', USE_SSL true, URL_STYLE 'path'

QUACK_TOKEN=replace-with-a-long-quack-token
DUCAN_API_TOKEN=replace-with-a-long-api-token
DUCAN_BIND_ADDRESS=127.0.0.1
DUCAN_API_PORT=8080
